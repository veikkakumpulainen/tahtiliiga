{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin/league/:id/register-team", "destination": "/admin/league/[id]/register-team.html" },
    { "source": "/admin/league/:id", "destination": "/admin/league/[id].html" },
    { "source": "/group/:id/chat", "destination": "/group/[id]/chat.html" },
